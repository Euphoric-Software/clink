{
  "about": [
    "Shared fixtures for the feed.json trust rules. Consumers: tools/tests/feed-config.tests.ps1 (Get-FeedConfig in tools/feed-lib.ps1) and the C# unit test of FeedTrust.Parse (Clink/Services/UpdateFeed.cs).",
    "Each case: name; json = the exact text of a feed.json (the placeholders @K1@ and @K2@ are replaced by the two public keys of 'keys' before parsing); ps and cs = the state each side must give",
    "('off', 'on' or 'misconfigured'; PowerShell: Get-FeedConfig returns a disabled config / an enabled one / throws; C#: FeedState.Off / On / Misconfigured); stableBase and devBase = the resolved bases (FeedTrust.FeedUrl",
    "and FeedTrust.DevFeedUrl, Get-FeedConfig -Channel stable / dev .FeedUrl) wherever cs is 'on' (and ps is 'on' too, they are then identical).",
    "Where ps and cs differ the PowerShell side is deliberately STRICTER: it accepts only canonical URLs (Uri.AbsoluteUri equal to the text), the client normalises them. A file that CI accepts therefore always resolves to the same bases in the client.",
    "The keys are throwaway public keys; no private half exists."
  ],
  "keys": {
    "K1": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEEU1mUkMO6JteUESqWDnspHlLVUFOUzSoAL99KlQy3IYZ23A8ZrOXJzG96b/A5podqp/asnzJ4+S3DH5qG4hDdw==",
    "K2": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAErt6NCzCtSCU4US1dgh6N7JOQosG0EKjlyrzJPy3TycUAOqnHc9hevVt28iFI2ap6+2RUe2Qdu9qL7XcGZq7KLw=="
  },
  "cases": [
    { "name": "off: the empty template", "json": "{\"schema\":1,\"feedUrl\":\"\",\"stableKeys\":[],\"devKeys\":[]}", "ps": "off", "cs": "off" },
    { "name": "off: only the schema", "json": "{\"schema\":1}", "ps": "off", "cs": "off" },
    { "name": "off: a blank feedUrl is empty", "json": "{\"schema\":1,\"feedUrl\":\"   \",\"stableKeys\":[],\"devKeys\":[]}", "ps": "off", "cs": "off" },
    { "name": "off: an empty devFeedUrl", "json": "{\"schema\":1,\"feedUrl\":\"\",\"devFeedUrl\":\"\",\"stableKeys\":[],\"devKeys\":[]}", "ps": "off", "cs": "off" },

    { "name": "on: both channels use feedUrl", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "on: a separate devFeedUrl", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":\"https://dl-dev.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl-dev.example/clink/" },
    { "name": "on: devFeedUrl \"\" means feedUrl", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":\"\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "on: devFeedUrl null means feedUrl", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":null,\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "on: devFeedUrl equal to feedUrl", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "on: sibling bases that only share a name prefix are not nested", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":\"https://dl.example/clink-dev/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink-dev/" },
    { "name": "on: the same path on different hosts is not nested", "json": "{\"schema\":1,\"feedUrl\":\"https://a.example/clink/\",\"devFeedUrl\":\"https://b.example/clink/dev/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://a.example/clink/", "devBase": "https://b.example/clink/dev/" },
    { "name": "on: white space around the URL and the keys is trimmed", "json": "{\"schema\":1,\"feedUrl\":\"  https://dl.example/clink/  \",\"stableKeys\":[\"  @K1@  \"],\"devKeys\":[\" @K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "on: unknown properties are ignored", "json": "{\"schema\":1,\"extra\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "on: a path with several segments and a port", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example:8443/a/b/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "on", "cs": "on", "stableBase": "https://dl.example:8443/a/b/", "devBase": "https://dl.example:8443/a/b/" },

    { "name": "misconfigured: a blank devFeedUrl counts as listed and is invalid", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":\"   \",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: devFeedUrl without feedUrl (with keys)", "json": "{\"schema\":1,\"feedUrl\":\"\",\"devFeedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: devFeedUrl alone", "json": "{\"schema\":1,\"feedUrl\":\"\",\"devFeedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[],\"devKeys\":[]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: devFeedUrl inside feedUrl", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":\"https://dl.example/clink/dev/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl inside devFeedUrl", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/stable/\",\"devFeedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl is a number", "json": "{\"schema\":1,\"feedUrl\":5,\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl is a list", "json": "{\"schema\":1,\"feedUrl\":[\"https://dl.example/clink/\"],\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: devFeedUrl is a bool", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"devFeedUrl\":true,\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: schema is a string", "json": "{\"schema\":\"1\",\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: schema 2", "json": "{\"schema\":2,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: schema 1.0 is not an integer", "json": "{\"schema\":1.0,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: schema is true", "json": "{\"schema\":true,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: no schema", "json": "{\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl is http", "json": "{\"schema\":1,\"feedUrl\":\"http://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl does not end in a slash", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl has a query", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/?x=1\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl has a fragment", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/#f\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl has user info", "json": "{\"schema\":1,\"feedUrl\":\"https://u@dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl is not absolute", "json": "{\"schema\":1,\"feedUrl\":\"dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: feedUrl is ftp", "json": "{\"schema\":1,\"feedUrl\":\"ftp://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: devKeys is empty", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: stableKeys is empty", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: keys without a feedUrl", "json": "{\"schema\":1,\"feedUrl\":\"\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: the same key in both lists", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K1@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: a key that is not Base64", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\",\"not base64!\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: a blank key", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\",\"  \"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: a key that is a number", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":[\"@K1@\",5],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: stableKeys is a string, not a list", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/clink/\",\"stableKeys\":\"@K1@\",\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: the root is a list", "json": "[]", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: the root is null", "json": "null", "ps": "misconfigured", "cs": "misconfigured" },
    { "name": "misconfigured: not JSON", "json": "{", "ps": "misconfigured", "cs": "misconfigured" },

    { "name": "stricter in PowerShell: an upper-case host", "json": "{\"schema\":1,\"feedUrl\":\"https://DL.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "stricter in PowerShell: an upper-case scheme", "json": "{\"schema\":1,\"feedUrl\":\"HTTPS://dl.example/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "stricter in PowerShell: the default port written out", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example:443/clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "stricter in PowerShell: a dot segment", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/a/../clink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "stricter in PowerShell: an escaped plain character", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/%63link/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "on", "stableBase": "https://dl.example/clink/", "devBase": "https://dl.example/clink/" },
    { "name": "stricter in PowerShell: a space in the path", "json": "{\"schema\":1,\"feedUrl\":\"https://dl.example/cl ink/\",\"stableKeys\":[\"@K1@\"],\"devKeys\":[\"@K2@\"]}", "ps": "misconfigured", "cs": "on", "stableBase": "https://dl.example/cl%20ink/", "devBase": "https://dl.example/cl%20ink/" }
  ]
}
