<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Clink</AssemblyName>
    <RootNamespace>Clink</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clink.ico</ApplicationIcon>
    <Version>0.4.1</Version>
    <!-- GitHub "owner/repo" the app checks for updates. Empty = updates off; CI passes -p:UpdateRepo=owner/repo -p:Version=X.Y.Z -->
    <UpdateRepo Condition="'$(UpdateRepo)' == ''"></UpdateRepo>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS8981</NoWarn>
    <SelfContained>false</SelfContained>
    <!-- A framework-dependent exe finds its runtime only in the machine-wide install (registry / Program Files\dotnet), never next to itself: an app-local hostfxr.dll planted beside an exe in a user-writable folder (updates\fx) is not loaded. -->
    <AppHostDotNetSearch Condition="'$(SelfContained)' != 'true'">Global</AppHostDotNetSearch>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- obj/bin are only excluded by default while they ARE the intermediate/output folders: a build with -p:BaseIntermediateOutputPath=obj_x must not compile the generated files of a normal build in obj\. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;obj_*/**;bin_*/**</DefaultItemExcludes>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.366">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Capture\Convert.hlsl" LogicalName="Convert.hlsl" />
    <!-- Trust anchors of the signed update feed (Services/UpdateFeed.cs, FeedTrust): {"schema":1,"feedUrl":"","stableKeys":[],"devKeys":[]}. Empty = GitHub only, as before. -->
    <EmbeddedResource Include="Assets\feed.json" LogicalName="feed.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <!-- What this build is, from $(SelfContained) alone (no separate property to override). Services/Packaging.cs cross-checks it against the runtime. -->
    <AssemblyMetadata Include="Packaging" Value="SelfContained" Condition="'$(SelfContained)' == 'true'" />
    <AssemblyMetadata Include="Packaging" Value="Framework" Condition="'$(SelfContained)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
