<Window x:Class="Clink.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clink" Width="330" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Panel}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Good}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource Display}" FontSize="13" Text="Clip saved" Margin="8,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" Click="Close_Click" />
            </Grid>
            <TextBlock x:Name="Subtitle" Grid.Row="1" Style="{StaticResource MutedText}" Margin="16,2,0,0" Text="" TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="ClipButtons" Grid.Row="2" Orientation="Horizontal" Margin="16,10,0,0">
                <!-- MinWidth: as wide as "Uploading… 100%", so Trim and Folder stay put while the percentage grows -->
                <Button x:Name="ShareButton" Style="{StaticResource AccentButton}" Content="Share to Copium" MinWidth="132" Click="Share_Click" />
                <Button Content="Trim" Margin="8,0,0,0" Click="Trim_Click" />
                <Button Content="Folder" Margin="8,0,0,0" Click="Folder_Click" />
            </StackPanel>
            <StackPanel x:Name="SharedButtons" Grid.Row="2" Orientation="Horizontal" Margin="16,10,0,0" Visibility="Collapsed">
                <Button x:Name="CopyButton" Style="{StaticResource AccentButton}" Content="Copy link" Click="Copy_Click" />
                <Button Content="Open" Margin="8,0,0,0" Click="Open_Click" />
            </StackPanel>
            <StackPanel x:Name="ScreenshotButtons" Grid.Row="2" Orientation="Horizontal" Margin="16,10,0,0" Visibility="Collapsed">
                <Button Style="{StaticResource AccentButton}" Content="Open" MinWidth="72" Click="ShotOpen_Click" />
                <Button Content="Folder" Margin="8,0,0,0" Click="ShotFolder_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
