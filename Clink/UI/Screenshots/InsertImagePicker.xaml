<Window x:Class="Clink.UI.Screenshots.InsertImagePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert image" Width="640" Height="480" MinWidth="460" MinHeight="360" ShowInTaskbar="False"
        UseLayoutRounding="True" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="42" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Style="{StaticResource Display}" Text="Insert image" Margin="16,0,60,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Margin="0,0,8,0" Click="Cancel_Click"
                        AutomationProperties.Name="Close" ToolTip="Close (Esc)" />
            </Grid>

            <Border DockPanel.Dock="Bottom" Padding="16,10,16,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Text="PNG, JPG or BMP, up to 16384 px on a side and 100 megapixels." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PasteButton" Content="Paste" Click="Paste_Click" Margin="0,0,8,0" AutomationProperties.Name="Paste the picture on the clipboard"
                                ToolTip="Insert the picture that is on the clipboard (Ctrl+V does it directly in the editor)" />
                        <Button x:Name="BrowseButton" Content="Browse…" Click="Browse_Click" Margin="0,0,8,0" AutomationProperties.Name="Browse for a picture file"
                                ToolTip="Choose a PNG, JPG or BMP file" />
                        <Button Content="Cancel" Click="Cancel_Click" AutomationProperties.Name="Cancel" ToolTip="Close without inserting (Esc)" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,6,8,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="RECENT SCREENSHOTS" Margin="0,6,0,8" />
                    <WrapPanel x:Name="Tiles" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,4,0,0"
                               Text="No other screenshots yet. Use Browse… to pick a file, or Paste." />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
