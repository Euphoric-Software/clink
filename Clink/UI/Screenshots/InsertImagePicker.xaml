<Window x:Class="Clink.UI.Screenshots.InsertImagePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Clink.UI"
        Title="{l:T 'Insert image'}" Width="640" Height="480" MinWidth="460" MinHeight="360" ShowInTaskbar="False"
        UseLayoutRounding="True" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="42" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Style="{StaticResource Display}" Text="{l:T 'Insert image'}" Margin="16,0,60,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Button Style="{StaticResource IconButton}" x:Name="CloseButton" Content="✕" HorizontalAlignment="Right" Margin="0,0,8,0" Click="Cancel_Click"
                        AutomationProperties.Name="{l:T 'Close'}" />
            </Grid>

            <Border DockPanel.Dock="Bottom" Padding="16,10,16,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Text="{l:T 'PNG, JPG or BMP, up to 16384 px on a side and 100 megapixels.'}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PasteButton" Content="{l:T 'Paste'}" Click="Paste_Click" Margin="0,0,8,0" AutomationProperties.Name="{l:T 'Paste the picture on the clipboard'}" />
                        <Button x:Name="BrowseButton" Content="{l:T 'Browse…'}" Click="Browse_Click" Margin="0,0,8,0" AutomationProperties.Name="{l:T 'Browse for a picture file'}"
                                ToolTip="{l:T 'Choose a PNG, JPG or BMP file'}" />
                        <Button x:Name="CancelButton" Content="{l:T 'Cancel'}" Click="Cancel_Click" AutomationProperties.Name="{l:T 'Cancel'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,6,8,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="{l:T 'RECENT SCREENSHOTS'}" Margin="0,6,0,8" />
                    <WrapPanel x:Name="Tiles" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,4,0,0"
                               Text="{l:T 'No other screenshots yet. Use Browse… to pick a file, or Paste.'}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
