<UserControl x:Class="Clink.UI.Screenshots.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Clink.UI"
             FontFamily="{StaticResource UiFont}" Focusable="False">
    <StackPanel>
        <!-- Row 1: tools, undo / redo, view, copy / save. The tooltips that name a key ("Pen (P)") are set in the code behind (SetKeyTips): the key is a {keys} placeholder there. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ToolPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="SelectTool" Style="{StaticResource PillRadio}" Content="{l:T 'Select'}" GroupName="EditorTool" Click="Tool_Click" Tag="Select" AutomationProperties.Name="{l:T 'Select tool'}"
                             Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="PenTool" Style="{StaticResource PillRadio}" Content="{l:T 'Pen'}" GroupName="EditorTool" Click="Tool_Click" Tag="Pen" AutomationProperties.Name="{l:T 'Pen tool'}"
                             Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="LineTool" Style="{StaticResource PillRadio}" Content="{l:T 'Line'}" GroupName="EditorTool" Click="Tool_Click" Tag="Line" AutomationProperties.Name="{l:T 'Line tool'}"
                             Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="StraightArrowTool" Style="{StaticResource PillRadio}" Content="{l:T 'Arrow'}" GroupName="EditorTool" Click="Tool_Click" Tag="StraightArrow" AutomationProperties.Name="{l:T 'Straight arrow tool'}"
                             Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="ArrowTool" Style="{StaticResource PillRadio}" Content="{l:T 'Freehand arrow'}" GroupName="EditorTool" Click="Tool_Click" Tag="Arrow" AutomationProperties.Name="{l:T 'Freehand arrow tool'}"
                             Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="RectangleTool" Style="{StaticResource PillRadio}" Content="{l:T 'Rectangle'}" GroupName="EditorTool" Click="Tool_Click" Tag="Rectangle" AutomationProperties.Name="{l:T 'Rectangle tool'}"
                             Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="TextTool" Style="{StaticResource PillRadio}" Content="{l:T 'Text'}" GroupName="EditorTool" Click="Tool_Click" Tag="Text" AutomationProperties.Name="{l:T 'Text tool'}"
                             Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="CropTool" Style="{StaticResource PillRadio}" Content="{l:T 'Crop'}" GroupName="EditorTool" Click="Tool_Click" Tag="Crop" AutomationProperties.Name="{l:T 'Crop tool'}"
                             Margin="0,0,10,0" Padding="10,4" />
                <Button x:Name="UndoButton" Style="{StaticResource GlyphButton}" Content="&#xE7A7;" l:RtlMirror.Glyph="True" Click="Undo_Click" AutomationProperties.Name="{l:T 'Undo'}" Margin="0,0,4,0" />
                <Button x:Name="RedoButton" Style="{StaticResource GlyphButton}" Content="&#xE7A6;" l:RtlMirror.Glyph="True" Click="Redo_Click" AutomationProperties.Name="{l:T 'Redo'}" />
            </StackPanel>
            <!-- the capture overlay's editing (compact): no zoom / copy / save, a Cancel and a Done instead -->
            <StackPanel x:Name="OverlayPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                <Button x:Name="CancelCaptureButton" Style="{StaticResource SmallButton}" Content="{l:T 'Cancel'}" Click="CancelCapture_Click" AutomationProperties.Name="{l:T 'Cancel the screenshot'}"
                        Margin="0,0,6,0" />
                <Button x:Name="DoneButton" Style="{StaticResource AccentButton}" Content="{l:T 'Done'}" Click="Done_Click" MinWidth="72" AutomationProperties.Name="{l:T 'Done'}" />
            </StackPanel>
            <StackPanel x:Name="ViewPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="FitButton" Style="{StaticResource SmallButton}" Content="{l:T 'zoom|Fit'}" Click="Fit_Click" AutomationProperties.Name="{l:T 'Zoom to fit'}" Margin="0,0,4,0" />
                <Button x:Name="ActualButton" Style="{StaticResource SmallButton}" Click="Actual_Click" AutomationProperties.Name="{l:T 'Zoom to 100 percent'}" Margin="0,0,4,0" />
                <TextBlock x:Name="ZoomText" Style="{StaticResource MutedText}" MinWidth="42" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="CopyButton" Style="{StaticResource SmallButton}" Content="{l:T 'Copy'}" Click="Copy_Click" AutomationProperties.Name="{l:T 'Copy to clipboard'}" Margin="0,0,4,0" />
                <Button x:Name="SaveButton" Style="{StaticResource SmallButton}" Content="{l:T 'Save'}" Click="Save_Click" AutomationProperties.Name="{l:T 'Save'}" />
            </StackPanel>
        </Grid>

        <!-- Row 2: effects (raster tools), insert image, adjustments -->
        <StackPanel x:Name="EffectsPanel" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MutedText}" Text="{l:T 'Effects'}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton x:Name="BlurTool" Style="{StaticResource PillRadio}" Content="{l:T 'Blur'}" GroupName="EditorTool" Click="Tool_Click" Tag="Blur" AutomationProperties.Name="{l:T 'Blur tool'}"
                         Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="PixelateTool" Style="{StaticResource PillRadio}" Content="{l:T 'Pixelate'}" GroupName="EditorTool" Click="Tool_Click" Tag="Pixelate" AutomationProperties.Name="{l:T 'Pixelate tool'}"
                         Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="HighlightTool" Style="{StaticResource PillRadio}" Content="{l:T 'Highlight'}" GroupName="EditorTool" Click="Tool_Click" Tag="Highlight" AutomationProperties.Name="{l:T 'Highlight tool'}"
                         Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="SpotlightTool" Style="{StaticResource PillRadio}" Content="{l:T 'Spotlight'}" GroupName="EditorTool" Click="Tool_Click" Tag="Spotlight" AutomationProperties.Name="{l:T 'Spotlight tool'}"
                         Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="MagnifyTool" Style="{StaticResource PillRadio}" Content="{l:T 'Magnify'}" GroupName="EditorTool" Click="Tool_Click" Tag="Magnify" AutomationProperties.Name="{l:T 'Magnify tool'}"
                         Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="EraseTool" Style="{StaticResource PillRadio}" Content="{l:T 'Erase'}" GroupName="EditorTool" Click="Tool_Click" Tag="Erase" AutomationProperties.Name="{l:T 'Smart erase tool'}"
                         Margin="0,0,10,0" Padding="10,4" />
            <Button x:Name="InsertButton" Style="{StaticResource SmallButton}" Click="Insert_Click" AutomationProperties.Name="{l:T 'Insert image'}" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE91B;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" />
                    <TextBlock Text="{l:T 'Insert image'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="NoWrap" />
                </StackPanel>
            </Button>
            <Button x:Name="AdjustButton" Style="{StaticResource SmallButton}" Click="Adjust_Click" AutomationProperties.Name="{l:T 'Adjustments'}"
                    ToolTip="{l:T 'Brightness, contrast and sharpness of the whole picture'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE706;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" />
                    <TextBlock Text="{l:T 'Adjust'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="NoWrap" />
                </StackPanel>
            </Button>
            <Popup x:Name="AdjustPopup" PlacementTarget="{Binding ElementName=AdjustButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="AdjustPopup_Closed" PopupAnimation="None">
                <Border Style="{StaticResource Card}" Background="{DynamicResource Bg}" Padding="14,12" Margin="0,6,12,12" MinWidth="320">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="{l:T 'ADJUSTMENTS'}" />
                        <Grid x:Name="AdjustGrid" />
                        <TextBlock x:Name="AdjustHint" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="{l:T 'Applies to the whole picture, under the annotations.'}" />
                        <Button x:Name="ResetAdjustButton" Style="{StaticResource SmallButton}" Content="{l:T 'Reset'}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetAdjust_Click"
                                AutomationProperties.Name="{l:T 'Reset adjustments'}" ToolTip="{l:T 'Brightness, contrast and sharpness back to 0'}" />
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Row 3: options of the current tool -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            <StackPanel x:Name="WidthPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T 'Width'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="WidthSlider" Minimum="1" Maximum="40" Width="110" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                        ValueChanged="Width_Changed" LostMouseCapture="Slider_LostCapture" AutomationProperties.Name="{l:T 'Line width'}" ToolTip="{l:T 'Line width in picture pixels'}" />
                <TextBlock x:Name="WidthText" Style="{StaticResource MutedText}" MinWidth="34" Margin="8,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight" />
            </StackPanel>
            <StackPanel x:Name="TextPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T 'Size'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="FontSlider" Minimum="10" Maximum="120" Width="110" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                        ValueChanged="Font_Changed" LostMouseCapture="Slider_LostCapture" AutomationProperties.Name="{l:T 'Text size'}" ToolTip="{l:T 'Text size in picture pixels'}" />
                <TextBlock x:Name="FontText" Style="{StaticResource MutedText}" MinWidth="34" Margin="8,0,12,0" VerticalAlignment="Center" Text="28" FlowDirection="LeftToRight" />
                <CheckBox x:Name="BoldCheck" Content="{l:T 'Bold'}" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Bold_Changed" Unchecked="Bold_Changed" AutomationProperties.Name="{l:T 'Bold text'}" />
                <RadioButton x:Name="BackdropNone" Style="{StaticResource PillRadio}" Content="{l:T 'No backdrop'}" GroupName="EditorBackdrop" Click="Backdrop_Click" Tag="None" Margin="0,0,4,0" Padding="9,3"
                             AutomationProperties.Name="{l:T 'No text backdrop'}" ToolTip="{l:T 'Plain text'}" />
                <RadioButton x:Name="BackdropBox" Style="{StaticResource PillRadio}" Content="{l:T 'Box'}" GroupName="EditorBackdrop" Click="Backdrop_Click" Tag="Box" Margin="0,0,4,0" Padding="9,3"
                             AutomationProperties.Name="{l:T 'Text on a box'}" ToolTip="{l:T 'Text on a dark rounded box'}" />
                <RadioButton x:Name="BackdropOutline" Style="{StaticResource PillRadio}" Content="{l:T 'Outline'}" GroupName="EditorBackdrop" Click="Backdrop_Click" Tag="Outline" Padding="9,3"
                             AutomationProperties.Name="{l:T 'Outlined text'}" ToolTip="{l:T 'Text with a dark outline (reads on any picture)'}" />
            </StackPanel>
            <Button x:Name="ResetCropButton" Style="{StaticResource SmallButton}" Content="{l:T 'Reset crop'}" Click="ResetCrop_Click" Visibility="Collapsed" Margin="12,0,0,0"
                    AutomationProperties.Name="{l:T 'Reset crop'}" ToolTip="{l:T 'Keep the whole picture again'}" />
            <!-- per-tool option panels of the raster tools: filled by the code behind -->
            <StackPanel x:Name="BlurPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="PixelatePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="HighlightPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="SpotlightPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="MagnifyPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="ErasePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T 'Drag over what to remove: the surroundings are continued into it'}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel x:Name="ImagePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>
