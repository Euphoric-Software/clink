<UserControl x:Class="Clink.UI.Screenshots.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Focusable="False">
    <StackPanel>
        <!-- Row 1: tools, undo / redo, view, copy / save -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ToolPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="SelectTool" Style="{StaticResource PillRadio}" Content="Select" GroupName="EditorTool" Click="Tool_Click" Tag="Select" AutomationProperties.Name="Select tool"
                             ToolTip="Select, move and resize (V)" Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="PenTool" Style="{StaticResource PillRadio}" Content="Pen" GroupName="EditorTool" Click="Tool_Click" Tag="Pen" AutomationProperties.Name="Pen tool"
                             ToolTip="Freehand pen (P)" Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="LineTool" Style="{StaticResource PillRadio}" Content="Line" GroupName="EditorTool" Click="Tool_Click" Tag="Line" AutomationProperties.Name="Line tool"
                             ToolTip="Straight line; Shift snaps to 45 degrees (L)" Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="StraightArrowTool" Style="{StaticResource PillRadio}" Content="Arrow" GroupName="EditorTool" Click="Tool_Click" Tag="StraightArrow" AutomationProperties.Name="Straight arrow tool"
                             ToolTip="Straight arrow; Shift snaps to 45 degrees (Shift+A)" Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="ArrowTool" Style="{StaticResource PillRadio}" Content="Freehand arrow" GroupName="EditorTool" Click="Tool_Click" Tag="Arrow" AutomationProperties.Name="Freehand arrow tool"
                             ToolTip="Draw a curve; the head points the way your hand was going (A)" Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="RectangleTool" Style="{StaticResource PillRadio}" Content="Rectangle" GroupName="EditorTool" Click="Tool_Click" Tag="Rectangle" AutomationProperties.Name="Rectangle tool"
                             ToolTip="Rectangle outline; Shift makes a square (R)" Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="TextTool" Style="{StaticResource PillRadio}" Content="Text" GroupName="EditorTool" Click="Tool_Click" Tag="Text" AutomationProperties.Name="Text tool"
                             ToolTip="Add text: click, type, Enter to finish, Shift+Enter for a new line (T)" Margin="0,0,4,0" Padding="10,4" />
                <RadioButton x:Name="CropTool" Style="{StaticResource PillRadio}" Content="Crop" GroupName="EditorTool" Click="Tool_Click" Tag="Crop" AutomationProperties.Name="Crop tool"
                             ToolTip="Choose the part of the picture to keep; undoable (C)" Margin="0,0,10,0" Padding="10,4" />
                <Button x:Name="UndoButton" Style="{StaticResource GlyphButton}" Content="&#xE7A7;" Click="Undo_Click" AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)" Margin="0,0,4,0" />
                <Button x:Name="RedoButton" Style="{StaticResource GlyphButton}" Content="&#xE7A6;" Click="Redo_Click" AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y)" />
            </StackPanel>
            <!-- the capture overlay's editing (compact): no zoom / copy / save, a Cancel and a Done instead -->
            <StackPanel x:Name="OverlayPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                <Button x:Name="CancelCaptureButton" Style="{StaticResource SmallButton}" Content="Cancel" Click="CancelCapture_Click" AutomationProperties.Name="Cancel the screenshot"
                        ToolTip="Throw the screenshot away (Esc, when there is nothing to deselect)" Margin="0,0,6,0" />
                <Button x:Name="DoneButton" Style="{StaticResource AccentButton}" Content="Done" Click="Done_Click" MinWidth="72" AutomationProperties.Name="Done"
                        ToolTip="Save the picture and copy it (Enter)" />
            </StackPanel>
            <StackPanel x:Name="ViewPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="FitButton" Style="{StaticResource SmallButton}" Content="Fit" Click="Fit_Click" AutomationProperties.Name="Zoom to fit" ToolTip="Fit the picture in the window (Ctrl+0)" Margin="0,0,4,0" />
                <Button x:Name="ActualButton" Style="{StaticResource SmallButton}" Content="100%" Click="Actual_Click" AutomationProperties.Name="Zoom to 100 percent" ToolTip="One picture pixel per screen pixel (Ctrl+1)" Margin="0,0,4,0" />
                <TextBlock x:Name="ZoomText" Style="{StaticResource MutedText}" MinWidth="42" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Text="100%" />
                <Button x:Name="CopyButton" Style="{StaticResource SmallButton}" Content="Copy" Click="Copy_Click" AutomationProperties.Name="Copy to clipboard" ToolTip="Copy the picture to the clipboard (Ctrl+C)" Margin="0,0,4,0" />
                <Button x:Name="SaveButton" Style="{StaticResource SmallButton}" Content="Save" Click="Save_Click" AutomationProperties.Name="Save" ToolTip="Save the picture as a PNG (Ctrl+S)" />
            </StackPanel>
        </Grid>

        <!-- Row 2: effects (raster tools), insert image, adjustments -->
        <StackPanel x:Name="EffectsPanel" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MutedText}" Text="Effects" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton x:Name="BlurTool" Style="{StaticResource PillRadio}" Content="Blur" GroupName="EditorTool" Click="Tool_Click" Tag="Blur" AutomationProperties.Name="Blur tool"
                         ToolTip="Blur a region: drag a rectangle (B)" Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="PixelateTool" Style="{StaticResource PillRadio}" Content="Pixelate" GroupName="EditorTool" Click="Tool_Click" Tag="Pixelate" AutomationProperties.Name="Pixelate tool"
                         ToolTip="Pixelate a region: drag a rectangle (X)" Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="HighlightTool" Style="{StaticResource PillRadio}" Content="Highlight" GroupName="EditorTool" Click="Tool_Click" Tag="Highlight" AutomationProperties.Name="Highlight tool"
                         ToolTip="Highlighter: drag a rectangle (Shift makes a square), or draw freehand (the Freehand option) (H)" Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="SpotlightTool" Style="{StaticResource PillRadio}" Content="Spotlight" GroupName="EditorTool" Click="Tool_Click" Tag="Spotlight" AutomationProperties.Name="Spotlight tool"
                         ToolTip="Spotlight: keep a box sharp, blur and darken the rest (S)" Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="MagnifyTool" Style="{StaticResource PillRadio}" Content="Magnify" GroupName="EditorTool" Click="Tool_Click" Tag="Magnify" AutomationProperties.Name="Magnify tool"
                         ToolTip="Magnify: drag over what to enlarge; the enlarged copy appears beside it (M)" Margin="0,0,4,0" Padding="10,4" />
            <RadioButton x:Name="EraseTool" Style="{StaticResource PillRadio}" Content="Erase" GroupName="EditorTool" Click="Tool_Click" Tag="Erase" AutomationProperties.Name="Smart erase tool"
                         ToolTip="Smart erase: drag over what to remove; the background is continued into it (E)" Margin="0,0,10,0" Padding="10,4" />
            <Button x:Name="InsertButton" Style="{StaticResource SmallButton}" Click="Insert_Click" AutomationProperties.Name="Insert image"
                    ToolTip="Insert an image: a recent screenshot, a file or the clipboard (I). Ctrl+V pastes the clipboard picture" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE91B;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" />
                    <TextBlock Text="Insert image" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="NoWrap" />
                </StackPanel>
            </Button>
            <Button x:Name="AdjustButton" Style="{StaticResource SmallButton}" Click="Adjust_Click" AutomationProperties.Name="Adjustments"
                    ToolTip="Brightness, contrast and sharpness of the whole picture">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE706;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" />
                    <TextBlock Text="Adjust" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="NoWrap" />
                </StackPanel>
            </Button>
            <Popup x:Name="AdjustPopup" PlacementTarget="{Binding ElementName=AdjustButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="AdjustPopup_Closed" PopupAnimation="None">
                <Border Style="{StaticResource Card}" Background="{DynamicResource Bg}" Padding="14,12" Margin="0,6,12,12" MinWidth="320">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="ADJUSTMENTS" />
                        <Grid x:Name="AdjustGrid" />
                        <TextBlock x:Name="AdjustHint" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="Applies to the whole picture, under the annotations." />
                        <Button x:Name="ResetAdjustButton" Style="{StaticResource SmallButton}" Content="Reset" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetAdjust_Click"
                                AutomationProperties.Name="Reset adjustments" ToolTip="Brightness, contrast and sharpness back to 0" />
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Row 3: options of the current tool -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            <StackPanel x:Name="WidthPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Style="{StaticResource MutedText}" Text="Width" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="WidthSlider" Minimum="1" Maximum="40" Width="110" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                        ValueChanged="Width_Changed" LostMouseCapture="Slider_LostCapture" AutomationProperties.Name="Line width" ToolTip="Line width in picture pixels" />
                <TextBlock x:Name="WidthText" Style="{StaticResource MutedText}" Width="34" Margin="8,0,0,0" VerticalAlignment="Center" Text="4 px" />
            </StackPanel>
            <StackPanel x:Name="TextPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource MutedText}" Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="FontSlider" Minimum="10" Maximum="120" Width="110" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                        ValueChanged="Font_Changed" LostMouseCapture="Slider_LostCapture" AutomationProperties.Name="Text size" ToolTip="Text size in picture pixels" />
                <TextBlock x:Name="FontText" Style="{StaticResource MutedText}" Width="34" Margin="8,0,12,0" VerticalAlignment="Center" Text="28" />
                <CheckBox x:Name="BoldCheck" Content="Bold" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Bold_Changed" Unchecked="Bold_Changed" AutomationProperties.Name="Bold text" />
                <RadioButton x:Name="BackdropNone" Style="{StaticResource PillRadio}" Content="No backdrop" GroupName="EditorBackdrop" Click="Backdrop_Click" Tag="None" Margin="0,0,4,0" Padding="9,3"
                             AutomationProperties.Name="No text backdrop" ToolTip="Plain text" />
                <RadioButton x:Name="BackdropBox" Style="{StaticResource PillRadio}" Content="Box" GroupName="EditorBackdrop" Click="Backdrop_Click" Tag="Box" Margin="0,0,4,0" Padding="9,3"
                             AutomationProperties.Name="Text on a box" ToolTip="Text on a dark rounded box" />
                <RadioButton x:Name="BackdropOutline" Style="{StaticResource PillRadio}" Content="Outline" GroupName="EditorBackdrop" Click="Backdrop_Click" Tag="Outline" Padding="9,3"
                             AutomationProperties.Name="Outlined text" ToolTip="Text with a dark outline (reads on any picture)" />
            </StackPanel>
            <Button x:Name="ResetCropButton" Style="{StaticResource SmallButton}" Content="Reset crop" Click="ResetCrop_Click" Visibility="Collapsed" Margin="12,0,0,0"
                    AutomationProperties.Name="Reset crop" ToolTip="Keep the whole picture again" />
            <!-- per-tool option panels of the raster tools: filled by the code behind -->
            <StackPanel x:Name="BlurPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="PixelatePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="HighlightPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="SpotlightPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="MagnifyPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="ErasePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Style="{StaticResource MutedText}" Text="Drag over what to remove: the surroundings are continued into it" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel x:Name="ImagePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>
