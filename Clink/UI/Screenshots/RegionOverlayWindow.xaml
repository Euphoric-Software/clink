<Window x:Class="Clink.UI.Screenshots.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clink screenshot" Width="640" Height="360" Left="0" Top="0" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Black"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Cursor="Cross" FontFamily="{StaticResource UiFont}">
    <!-- One of these per monitor. Everything is positioned in code (RegionOverlayWindow.Layout): the frozen picture is sized to exactly one
         image pixel per physical pixel, the rest follows RegionSelection. Opaque on purpose (no layered-window path). -->
    <Canvas x:Name="Root" ClipToBounds="True" Background="Black">
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" />
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="Frame" Stroke="{DynamicResource Accent}" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
        <Border x:Name="SizeBox" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="7,3">
            <TextBlock x:Name="SizeText" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold" />
        </Border>
        <Border x:Name="LoupeBox" Visibility="Collapsed" IsHitTestVisible="False" Width="136" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}"
                BorderThickness="1" CornerRadius="4" Padding="3">
            <StackPanel>
                <Grid Width="128" Height="128">
                    <Rectangle x:Name="LoupeView" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <!-- the pixel under the pointer: 8 x 8 DIP of the 8x zoom -->
                    <Rectangle Width="8" Height="8" Stroke="White" StrokeThickness="1" />
                    <Rectangle Width="10" Height="10" Stroke="Black" StrokeThickness="1" />
                </Grid>
                <TextBlock x:Name="LoupeText" Foreground="{DynamicResource Fg}" FontSize="11" Margin="0,3,0,0" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
