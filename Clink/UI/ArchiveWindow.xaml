<Window x:Class="Clink.UI.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive clips" Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Every colour here is a DynamicResource, so the window follows the theme when it changes. -->
    <Window.Resources>
        <!-- One of the two things to move: a raised box with a round selector; its content is a title line and a muted line under it -->
        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" Margin="0,1,12,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Panel2}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <DockPanel>
            <!-- header / drag area -->
            <Grid DockPanel.Dock="Top" Height="44" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Text="Archive clips" FontWeight="SemiBold" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Margin="0,0,8,0" Click="Close_Click" ToolTip="Close (a move in progress is cancelled)" />
            </Grid>

            <!-- buttons -->
            <Border DockPanel.Dock="Bottom" Padding="16,10,16,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ArchiveButton" Style="{StaticResource AccentButton}" Content="Archive" MinWidth="84" Margin="0,0,8,0" IsEnabled="False" Click="Archive_Click"
                            ToolTip="Move the clips chosen above to the archive location" />
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="84" Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click"
                            ToolTip="Stop after the clip being copied: its partial copy is deleted and its local file stays" />
                    <Button x:Name="CloseButton" Content="Close" MinWidth="84" Click="Close_Click" />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,2,16,14">
                <TextBlock Style="{StaticResource H}" Text="MOVE CLIPS TO" Margin="0,8,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="DestinationText" FontWeight="SemiBold" />
                        <TextBlock x:Name="DestinationInfo" Style="{StaticResource MutedText}" Margin="0,3,0,0" Text="Checking the location…" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H}" Text="WHAT TO MOVE" Margin="0,16,0,6" />
                <RadioButton x:Name="DueRadio" GroupName="ArchiveScope" Style="{StaticResource ChoiceRadio}" IsEnabled="False" Checked="Scope_Changed"
                             AutomationProperties.Name="{Binding Text, ElementName=DueTitle}">
                    <StackPanel>
                        <TextBlock x:Name="DueTitle" Text="Everything due by your rules (counting…)" />
                        <TextBlock x:Name="DueRule" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AllRadio" GroupName="ArchiveScope" Style="{StaticResource ChoiceRadio}" Margin="0,8,0,0" IsEnabled="False" Checked="Scope_Changed"
                             AutomationProperties.Name="{Binding Text, ElementName=AllTitle}">
                    <StackPanel>
                        <TextBlock x:Name="AllTitle" Text="All local clips (counting…)" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="Every clip in the clips folder, oldest first, whatever the rules say" />
                    </StackPanel>
                </RadioButton>
                <TextBlock Style="{StaticResource Hint}" Margin="2,10,0,0"
                           Text="Each clip is copied and checked first, and only then deleted from this PC; it stays in your library. A clip that is open, or was saved in the last 30 seconds, is skipped." />

                <ProgressBar x:Name="Bar" Margin="0,16,0,0" Height="6" Minimum="0" Maximum="100" Visibility="Hidden" />
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="2,8,0,0" MinHeight="34" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
