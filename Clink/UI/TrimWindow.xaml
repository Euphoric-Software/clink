<Window x:Class="Clink.UI.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Clink.UI"
        Title="Trim clip" Width="940" Height="720" MinWidth="720" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- "Listen" pill: which single track the preview plays (radio, one per track row) -->
        <Style x:Key="MonitorRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="9,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Panel3}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FF0E1419" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Bg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="42" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="Trim" FontWeight="SemiBold" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Margin="0,0,8,0" Click="Close_Click" />
            </Grid>

            <!-- Bottom row: replace / save / share / status -->
            <Border DockPanel.Dock="Bottom" Padding="16,10,16,14" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ReplaceCheck" Content="Replace original" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button x:Name="SaveButton" Content="Save trimmed" Click="Save_Click" Margin="0,0,8,0" />
                        <Button x:Name="SaveShareButton" Style="{StaticResource AccentButton}" Content="Save &amp; share" Click="SaveShare_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Audio tracks: one row per track (include, name, listen, volume) -->
            <Border DockPanel.Dock="Bottom" Padding="16,8,16,8" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="AUDIO TRACKS" Style="{StaticResource H}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TracksHint" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="110,0,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Opening preview…" />
                    </Grid>
                    <StackPanel x:Name="TracksPanel" />
                </StackPanel>
            </Border>

            <!-- Timeline with in/out handles and the playhead -->
            <ui:TimelineControl x:Name="Timeline" DockPanel.Dock="Bottom" Margin="6,0,6,2" />

            <!-- Transport row -->
            <Grid DockPanel.Dock="Bottom" Margin="16,8,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Content="▶" Width="40" Click="Play_Click" Margin="0,0,10,0" ToolTip="Play / pause (Space)" />
                <TextBlock x:Name="PosText" Grid.Column="1" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" Text="0:00.0 / 0:00.0" TextWrapping="NoWrap" />
                <Button Grid.Column="2" Content="[ Set in" Click="SetIn_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Set the start to the playhead (I)" />
                <Button Grid.Column="3" Content="Set out ]" Click="SetOut_Click" Padding="8,4" Margin="0,0,12,0" ToolTip="Set the end to the playhead (O)" />
                <TextBlock Grid.Column="4" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Text="Start snaps to keyframes · Space play · I/O set in/out · ←/→ frame step" />
            </Grid>

            <!-- Video preview (click toggles play) -->
            <Border Background="Black" Margin="1,0,1,0" MouseLeftButtonUp="Preview_Click" Cursor="Hand">
                <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True" />
            </Border>
        </DockPanel>
    </Border>
</Window>
