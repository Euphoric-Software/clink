<Window x:Class="Clink.UI.ThirdPartyNoticesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Third-party notices" Width="780" Height="580" MinWidth="420" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display"
        AutomationProperties.AutomationId="ThirdPartyNoticesWindow" AutomationProperties.Name="Third-party notices">
    <!-- Every colour here is a DynamicResource, so the window follows the theme when it changes. -->
    <Border Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <DockPanel>
            <!-- header / drag area -->
            <Grid DockPanel.Dock="Top" Height="44" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Style="{StaticResource Display}" Text="Third-party notices" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Margin="0,0,8,0" Click="Close_Click" ToolTip="Close"
                        AutomationProperties.Name="Close" />
            </Grid>

            <!-- buttons -->
            <Border DockPanel.Dock="Bottom" Padding="16,10,16,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <Button x:Name="CloseButton" Content="Close" MinWidth="84" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
            </Border>

            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="18,0,16,8"
                       Text="The licences of the software Clink includes or builds on. Clink's own licence is the first section." />

            <TextBox x:Name="NoticesText" Margin="16,0,16,12" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource Panel}" Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                     BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10,8"
                     AutomationProperties.Name="Third-party notices" />
        </DockPanel>
    </Border>
</Window>
