<UserControl x:Class="Clink.UI.ClipsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <!-- icons after the title: cloud = shared, scissors = trim, PC = local only, drive = archived -->
        <DataTemplate x:Key="Icons">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE753;" Foreground="{DynamicResource Accent}" Margin="0,1,5,0" ToolTip="Shared to Copium" Visibility="{Binding IsShared, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" Margin="0,1,5,0" ToolTip="Trimmed clip" Visibility="{Binding IsTrim, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE977;" Margin="0,1,5,0" ToolTip="Local only (not shared, not archived)" Visibility="{Binding IsLocalOnly, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Margin="0,1,5,0" ToolTip="{Binding ArchiveTip}" Visibility="{Binding IsArchived, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Accent2, not Accent: the accent as text fails 4.5:1 on the light theme for several accents (e.g. Orange, Pink); Accent2 reads on both -->
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Foreground" Value="{DynamicResource Accent2}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ToolTip" Value="{Binding Status}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The lists are virtualized (only the rows on screen get visuals), so every clip is listed however many there are. -->
        <Style x:Key="ClipList" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The screenshots list is a ListBox only for what it gives UI Automation: every row is a ListBoxItem (a named element with an automation peer, so its buttons
             are reachable after the list is rebuilt). It looks like the ItemsControl lists: no selection visual, no focus stop of its own, virtualized. -->
        <Style x:Key="ShotListItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShotList" TargetType="ListBox">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ShotListItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0" CanContentScroll="True" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UploadBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUploading}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The trim count + chevron toggle on a clip that has trims under it. Muted text on the row (the theme's muted-on-panel pairing); the chevron points down when open. -->
        <Style x:Key="TrimsToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <!-- just the count (the word would squeeze the title at the narrowest window); the tooltip and UIA name say "N trims of <title>" -->
                                <TextBlock Text="{Binding ChildCount}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Chevron" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="10" Margin="6,1,0,0" Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Panel3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Local / Trimmed row: thumbnail · title + icons · meta · Trim / Share / folder / Delete -->
        <DataTemplate x:Key="LocalRow">
            <Grid>
            <!-- a trim listed under its clip: indented, with a quiet guide line down the left (the full height of the row, gap included, so a run of trims reads as one block) -->
            <Border Width="2" HorizontalAlignment="Left" Margin="13,0,0,0" Background="{DynamicResource Border}" Visibility="{Binding IsChild, Converter={StaticResource Vis}}" />
            <Border Style="{StaticResource Row}" Margin="{Binding NestMargin}" Cursor="Hand" PreviewMouseLeftButtonDown="Row_Down" MouseLeftButtonUp="Row_Click">
                <!-- a click anywhere on the row that is not on one of its buttons plays the clip -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="88" Height="50" CornerRadius="4" Background="{DynamicResource Panel3}" Cursor="Hand" MouseLeftButtonUp="Thumb_Click" ToolTip="Play">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,88,50" RadiusX="4" RadiusY="4" />
                        </Border.Clip>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="False">
                            <!-- a clip with trims under it: the trim count and a chevron (a focusable toggle; the pane keeps the state) -->
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource TrimsToggle}" Margin="6,0,0,0" IsChecked="{Binding IsExpanded, Mode=OneWay}" Checked="Trims_Changed" Unchecked="Trims_Changed"
                                          Visibility="{Binding IsParent, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding ToggleName}" ToolTip="{Binding ToggleName}" />
                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Icons}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                        <ProgressBar Value="{Binding Progress}" Maximum="1" Style="{StaticResource UploadBar}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Trim" Click="Trim_Click" Padding="9,5" Margin="0,0,4,0" />
                        <!-- MinWidth = the "Copy link" width: Trim and the folder button stay in fixed columns down the list -->
                        <Button Content="{Binding ShareLabel}" Click="Share_Click" Padding="9,5" Margin="0,0,4,0" MinWidth="76" Style="{StaticResource AccentButton}"
                                AutomationProperties.Name="{Binding ShareName}"
                                Visibility="{Binding ShareVisible, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE8B7;" Click="Folder_Click" Padding="7,5" Margin="0,0,4,0" ToolTip="Show in folder" />
                        <!-- grey like Trim and the folder button, red under the pointer; off only while the clip is being deleted -->
                        <Button Style="{StaticResource DangerGlyphButton}" Content="&#xE74D;" Click="ClipDelete_Click" Padding="7,5" ToolTip="Delete" AutomationProperties.Name="Delete clip"
                                IsEnabled="{Binding CanDelete}" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </DataTemplate>

        <!-- Cloud row: title · date · the link (click = copy) · Open page · folder when the local file still exists -->
        <DataTemplate x:Key="CloudRow">
            <Border PreviewMouseLeftButtonDown="Row_Down" MouseLeftButtonUp="Row_Click">
                <Border.Style>
                    <!-- a click on the row plays the local file; no hand over a shared clip whose file is gone (an archived one still answers: "archive offline") -->
                    <Style TargetType="Border" BasedOn="{StaticResource Row}">
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasLocalFile}" Value="False" />
                                    <Condition Binding="{Binding IsArchived}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Cursor" Value="Arrow" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="88" Height="50" CornerRadius="4" Background="{DynamicResource Panel3}" Cursor="Hand" MouseLeftButtonUp="Thumb_Click" ToolTip="Play"
                            Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,88,50" RadiusX="4" RadiusY="4" />
                        </Border.Clip>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="False">
                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Icons}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding CloudMeta}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button Style="{StaticResource LinkButton}" Click="CopyLink_Click" Padding="0,1" HorizontalAlignment="Left" FontSize="12" ToolTip="Click to copy the link">
                            <TextBlock Text="{Binding Link}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource Accent2}" />
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open page" Click="OpenPage_Click" Padding="10,5" Margin="0,0,6,0" ToolTip="Open the clip on copium.pics" />
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE8B7;" Click="Folder_Click" Padding="8,5" ToolTip="Show the local file in its folder"
                                Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Screenshot row: 176 x 99 thumbnail, title + meta (+ link when shared) + status, then Edit / Open / folder / Upload or Copy link + Open page / Delete.
             A click on the row (not on a button) edits the screenshot. -->
        <DataTemplate x:Key="ShotRow">
            <Border Style="{StaticResource Row}" Cursor="Hand" PreviewMouseLeftButtonDown="Shot_Down" MouseLeftButtonUp="Shot_Click"
                    Loaded="ShotRow_Loaded" DataContextChanged="ShotRow_DataContextChanged" AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="176" Height="99" CornerRadius="4" Background="{DynamicResource Panel3}" VerticalAlignment="Top" ToolTip="Edit"
                            Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,176,99" RadiusX="4" RadiusY="4" />
                        </Border.Clip>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE753;" Foreground="{DynamicResource Accent}" Margin="6,1,0,0" ToolTip="Shared to Copium"
                                       Visibility="{Binding HasLink, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Meta}" />
                        <Button Style="{StaticResource LinkButton}" Click="ShotCopyLink_Click" Padding="0,1" HorizontalAlignment="Left" FontSize="12" ToolTip="Click to copy the link"
                                Visibility="{Binding HasLink, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Link}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource Accent2}" />
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Edit" Click="ShotEdit_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" AutomationProperties.Name="Edit screenshot"
                                    Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}" />
                            <Button Content="Open" Click="ShotOpen_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" AutomationProperties.Name="Open screenshot" ToolTip="Open in the default image viewer"
                                    Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE8B7;" Click="ShotFolder_Click" Padding="8,4" Margin="0,0,6,4" ToolTip="Show in folder" AutomationProperties.Name="Show in folder"
                                    Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}" />
                            <Button Content="Upload" Click="ShotUpload_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" AutomationProperties.Name="Upload to Copium" ToolTip="Upload to Copium"
                                    Visibility="{Binding UploadVisible, Converter={StaticResource Vis}}" />
                            <Button Content="Copy link" Click="ShotCopyLink_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" AutomationProperties.Name="Copy link"
                                    Visibility="{Binding HasLink, Converter={StaticResource Vis}}" />
                            <Button Content="Open page" Click="ShotOpenPage_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" ToolTip="Open the screenshot on copium.pics" AutomationProperties.Name="Open page"
                                    Visibility="{Binding HasPage, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE74D;" Click="ShotDelete_Click" Padding="8,4" Margin="0,0,0,4" ToolTip="Delete (to the Recycle Bin)" AutomationProperties.Name="Delete screenshot"
                                    Visibility="{Binding DeleteVisible, Converter={StaticResource Vis}}" />
                            <Button Content="Remove from list" Click="ShotDelete_Click" Style="{StaticResource SmallButton}" Margin="0,0,0,4" AutomationProperties.Name="Remove from list"
                                    ToolTip="Remove from this list. The link stays on Copium" Visibility="{Binding RemoveVisible, Converter={StaticResource Vis}}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top level: Clips | Screenshots (hidden when only one feature is on: that one is implied) -->
        <Border x:Name="FeatureBar" Grid.Row="0" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,8">
            <UniformGrid Columns="2">
                <RadioButton x:Name="ClipsFeature" GroupName="LibraryFeature" Style="{StaticResource SegmentPrimary}" Content="Clips" AutomationProperties.Name="Clips"
                             Checked="Feature_Checked" />
                <RadioButton x:Name="ShotsFeature" GroupName="LibraryFeature" Style="{StaticResource SegmentPrimary}" Content="Screenshots" AutomationProperties.Name="Screenshots"
                             Checked="Feature_Checked" />
            </UniformGrid>
        </Border>

        <!-- Second level, lower and quieter: Local | Shared, and on the clips side the Trimmed filter -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <!-- Panel, not Panel3: the muted segment text measures 4.5:1 on Bg / Panel / Panel2 in both themes (ThemeTests), not on Panel3 -->
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LocalLevel" GroupName="LibraryLevel" Style="{StaticResource SegmentSecondary}" Content="Local" AutomationProperties.Name="Local" Checked="Level_Checked" />
                    <RadioButton x:Name="SharedLevel" GroupName="LibraryLevel" Style="{StaticResource SegmentSecondary}" Content="Shared" AutomationProperties.Name="Shared" Checked="Level_Checked" />
                </StackPanel>
            </Border>
            <ToggleButton x:Name="TrimmedChip" Style="{StaticResource FilterChip}" Content="Trimmed" HorizontalAlignment="Right" AutomationProperties.Name="Trimmed"
                          ToolTip="Show only trimmed clips" Checked="Trimmed_Changed" Unchecked="Trimmed_Changed" />
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="8" TextWrapping="Wrap" />
            <ItemsControl x:Name="ClipLocalList" ItemTemplate="{StaticResource LocalRow}" Style="{StaticResource ClipList}" />
            <ItemsControl x:Name="ClipSharedList" ItemTemplate="{StaticResource CloudRow}" Style="{StaticResource ClipList}" Visibility="Collapsed" />
            <ListBox x:Name="ShotList" ItemTemplate="{StaticResource ShotRow}" Style="{StaticResource ShotList}" Visibility="Collapsed" AutomationProperties.Name="Screenshots list" />
        </Grid>
    </Grid>
</UserControl>
