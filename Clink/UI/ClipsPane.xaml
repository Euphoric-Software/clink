<UserControl x:Class="Clink.UI.ClipsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <!-- icons after the title: cloud = shared, scissors = trim, PC = local only, drive = archived -->
        <DataTemplate x:Key="Icons">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE753;" Foreground="{StaticResource Accent}" Margin="0,1,5,0" ToolTip="Shared to Copium" Visibility="{Binding IsShared, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" Margin="0,1,5,0" ToolTip="Trimmed clip" Visibility="{Binding IsTrim, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE977;" Margin="0,1,5,0" ToolTip="Local only (not shared, not archived)" Visibility="{Binding IsLocalOnly, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Margin="0,1,5,0" ToolTip="{Binding ArchiveTip}" Visibility="{Binding IsArchived, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ToolTip" Value="{Binding Status}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The lists are virtualized (only the rows on screen get visuals), so every clip is listed however many there are. -->
        <Style x:Key="ClipList" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UploadBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUploading}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Local / Trimmed row: thumbnail · title + icons · meta · Trim / Share / folder -->
        <DataTemplate x:Key="LocalRow">
            <Border Style="{StaticResource Row}" Cursor="Hand" PreviewMouseLeftButtonDown="Row_Down" MouseLeftButtonUp="Row_Click">
                <!-- a click anywhere on the row that is not on one of its buttons plays the clip -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="88" Height="50" CornerRadius="4" Background="{StaticResource Panel3}" Cursor="Hand" MouseLeftButtonUp="Thumb_Click" ToolTip="Play">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,88,50" RadiusX="4" RadiusY="4" />
                        </Border.Clip>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="False">
                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Icons}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                        <ProgressBar Value="{Binding Progress}" Maximum="1" Style="{StaticResource UploadBar}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Trim" Click="Trim_Click" Padding="10,5" Margin="0,0,6,0" />
                        <!-- MinWidth = the "Copy link" width: Trim and the folder button stay in fixed columns down the list -->
                        <Button Content="{Binding ShareLabel}" Click="Share_Click" Padding="10,5" Margin="0,0,6,0" MinWidth="82" Style="{StaticResource AccentButton}" />
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE8B7;" Click="Folder_Click" Padding="8,5" ToolTip="Show in folder" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Cloud row: title · date · the link (click = copy) · Open page · folder when the local file still exists -->
        <DataTemplate x:Key="CloudRow">
            <Border PreviewMouseLeftButtonDown="Row_Down" MouseLeftButtonUp="Row_Click">
                <Border.Style>
                    <!-- a click on the row plays the local file; no hand over a shared clip whose file is gone (an archived one still answers: "archive offline") -->
                    <Style TargetType="Border" BasedOn="{StaticResource Row}">
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasLocalFile}" Value="False" />
                                    <Condition Binding="{Binding IsArchived}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Cursor" Value="Arrow" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="88" Height="50" CornerRadius="4" Background="{StaticResource Panel3}" Cursor="Hand" MouseLeftButtonUp="Thumb_Click" ToolTip="Play"
                            Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,88,50" RadiusX="4" RadiusY="4" />
                        </Border.Clip>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="False">
                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Icons}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding CloudMeta}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button Style="{StaticResource LinkButton}" Click="CopyLink_Click" Padding="0,1" HorizontalAlignment="Left" FontSize="12" ToolTip="Click to copy the link">
                            <TextBlock Text="{Binding Link}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{StaticResource Accent}" />
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open page" Click="OpenPage_Click" Padding="10,5" Margin="0,0,6,0" ToolTip="Open the clip on copium.pics" />
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE8B7;" Click="Folder_Click" Padding="8,5" ToolTip="Show the local file in its folder"
                                Visibility="{Binding HasLocalFile, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl x:Name="Tabs">
        <TabItem x:Name="LocalTab" Header="Local">
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="NoLocalText" Style="{StaticResource MutedText}" Margin="8" Text="No clips yet. Press the hotkey while gaming." />
                <ItemsControl x:Name="LocalList" ItemTemplate="{StaticResource LocalRow}" Style="{StaticResource ClipList}" />
            </Grid>
        </TabItem>
        <TabItem x:Name="SharedTab" Header="Shared">
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="NoSharedText" Style="{StaticResource MutedText}" Margin="8" Text="Nothing shared yet. Share a clip and it is listed here, even after the local file is gone." />
                <ItemsControl x:Name="SharedList" ItemTemplate="{StaticResource CloudRow}" Style="{StaticResource ClipList}" />
            </Grid>
        </TabItem>
        <TabItem x:Name="TrimTab" Header="Trimmed">
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="NoTrimText" Style="{StaticResource MutedText}" Margin="8" Text="No trimmed clips yet. Trim saves a cut copy next to the original." />
                <ItemsControl x:Name="TrimList" ItemTemplate="{StaticResource LocalRow}" Style="{StaticResource ClipList}" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
