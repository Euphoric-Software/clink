<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The colour tokens, Dark theme with the Cyan accent: the brand palette (Midnight, Slate, Electric Cyan, Blue Cyan, Cool White).
         App.xaml merges this dictionary FIRST (index 0). ThemeManager.Apply replaces it at runtime with the chosen theme and accent,
         built in code from the same token names, so everything that has to follow a switch refers to these keys through
         DynamicResource (a StaticResource keeps the brush it found when it was loaded). These values are what the app has before
         Apply runs; ThemeTests checks that they equal ThemeManager's dark/cyan, so change both together. -->
    <Color x:Key="BgColor">#FF0A0E14</Color>
    <SolidColorBrush x:Key="Bg" Color="#FF0A0E14" />
    <SolidColorBrush x:Key="Panel" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="Panel2" Color="#FF232A37" />
    <SolidColorBrush x:Key="Panel3" Color="#FF2E3645" />
    <SolidColorBrush x:Key="Border" Color="#FF2A3240" />
    <SolidColorBrush x:Key="Fg" Color="#FFEAF2FF" />
    <SolidColorBrush x:Key="Muted" Color="#FF8A94A6" />
    <SolidColorBrush x:Key="Accent" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="AccentDim" Color="#FF1B6F84" />
    <!-- the secondary accent: links, focus rings, the played part of a seek bar, the hover outline of a secondary button -->
    <SolidColorBrush x:Key="Accent2" Color="#FF3B82F6" />
    <!-- text and glyphs on an Accent fill -->
    <SolidColorBrush x:Key="OnAccent" Color="#FF0A0E14" />
    <SolidColorBrush x:Key="Good" Color="#FF5EDB8A" />
    <SolidColorBrush x:Key="Warn" Color="#FFF2C94C" />
    <!-- Warn at 12 %: the background of a warning banner (the border stays full Warn) -->
    <SolidColorBrush x:Key="WarnTint" Color="#FFF2C94C" Opacity="0.12" />
    <SolidColorBrush x:Key="Danger" Color="#FFF26B6B" />
    <!-- Danger at 44 %: the part of the replay-length slider the machine's RAM cannot hold -->
    <SolidColorBrush x:Key="DangerTint" Color="#FFF26B6B" Opacity="0.44" />
</ResourceDictionary>
