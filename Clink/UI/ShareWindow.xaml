<Window x:Class="Clink.UI.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share clip" Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" FontFamily="{StaticResource UiFont}" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Every colour in this file is a DynamicResource: the window follows a theme change while it is open. -->
    <Border Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <StackPanel>
            <Grid Height="42" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Style="{StaticResource Display}" Text="Share clip" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Margin="0,0,8,0" Click="Close_Click" ToolTip="Close (Esc)" />
            </Grid>

            <TextBlock x:Name="IntroText" Style="{StaticResource MutedText}" Margin="16,0,16,10"
                       Text="No Copium token yet, so there is no link to copy. Share the file itself:" />

            <!-- The file card: drag it out (always a copy, the clip stays in the library) -->
            <Border x:Name="Card" Margin="16,0" CornerRadius="8" Padding="12"
                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Panel}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Panel2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="176" Height="100" CornerRadius="6" Background="{DynamicResource Panel3}" VerticalAlignment="Top">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,176,100" RadiusX="6" RadiusY="6" />
                        </Border.Clip>
                        <Grid>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="26" HorizontalAlignment="Center" />
                            <Image x:Name="ThumbImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                        <TextBlock x:Name="MetaText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Drag into Discord, a browser upload box or a folder" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- What just happened (file copied, dropped) or why the card is greyed out; two lines are reserved so the window does not jump -->
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="18,8,16,0" MinHeight="32" Text="" />

            <Grid Margin="16,4,16,16">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CopyButton" Style="{StaticResource AccentButton}" Content="Copy file" Click="CopyFile_Click" Margin="0,0,8,0"
                            ToolTip="Copy the file, then paste it into Discord or a folder with Ctrl+V (Ctrl+C in this window does the same)" />
                    <Button x:Name="FolderButton" Content="Open folder" Click="OpenFolder_Click" Margin="0,0,8,0" ToolTip="Show the file in its folder" />
                    <Button x:Name="SetUpCopiumButton" Content="Set up Copium…" Click="SetUpCopium_Click" ToolTip="Sign in with Copium under App → Copium: Share then uploads the clip and copies the link (after you agree once)" />
                </StackPanel>
                <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
