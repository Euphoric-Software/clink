<Application x:Class="Clink.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette first (index 0): ThemeManager.Apply swaps it for the chosen theme and accent. Theme.xaml refers to its keys
                     through DynamicResource only (a StaticResource cannot see a sibling dictionary while this one loads). -->
                <ResourceDictionary Source="UI/Palette.xaml" />
                <ResourceDictionary Source="UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
