<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain pins for every restore of this repo (local, CI, release).
  - <clear/> drops the user and machine level sources; nuget.org is the only source and every package id maps to it.
  - signatureValidationMode=require: a package that is unsigned, or signed by anyone but a trusted signer below, fails the restore (NU3004/NU3034).
  - trustedSigners: the Microsoft Corporation AUTHOR signing certificates (SHA-256 fingerprints, verbatim from the output of `dotnet nuget verify` with the all-signatures option).
    Every package this repo restores is Microsoft-authored (runtime packs, ILLink tasks, CsWin32 and the Windows SDK metadata/projection packs).
    Microsoft signs different packages with different certificates, so there are several; all three are in use today:
      9A1B...  valid 2026-09-07..2027-12-03  .NET 10 runtime packs, Microsoft.AspNetCore.App.Runtime.win-x64, ILLink, CsWin32, Win32Metadata 71.x
      566A...  valid 2023-07-26..2026-10-17  Windows.SDK.NET.Ref, WDK.Win32Metadata (validated by their timestamps)
      AA12...  valid 2020-09-29..2023-10-05  Windows.SDK.Win32Docs 0.1.42-alpha (validated by its timestamp)
    Rotation runbook. When Microsoft rotates a certificate the restore of the new package fails with NU3034. That error does NOT print the
    fingerprint, and a package that fails verification is never extracted, so get the file yourself:
      1. Download https://api.nuget.org/v3-flatcontainer/<id>/<ver>/<id>.<ver>.nupkg (id lower case) into a scratch folder.
      2. Run `dotnet nuget verify` with the all-signatures option (the flag is spelled with two hyphens, which XML comments cannot hold) on the file and read the signer certificate's SHA-256 fingerprint.
      3. Check that the Subject is CN=Microsoft Corporation and check the chain root (a Microsoft root, not an untrusted one).
      4. Add the new fingerprint below in a reviewed change. That loud failure is the point.
    fallbackPackageFolders is cleared so no machine-level folder can satisfy a package without the checks above.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <clear />
    <author name="Microsoft">
      <certificate fingerprint="9A1B131BEE0605433056A4EA3815478A8E177961A968C6C0027C1093D1FEB630" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="566A31882BE208BE4422F7CFD66ED09F5D4524A5994F50CCC8B05EC0528C1353" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="AA12DA22A49BCE7D5C1AE64CC1F3D892F150DA76140F210ABD2CBFFCA2C18A27" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
  </trustedSigners>
</configuration>
